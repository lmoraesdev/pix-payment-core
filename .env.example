# Application
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=pix_payment

# TypeORM
# Schema is managed by migrations (src/database/migrations) — never true outside
# of a throwaway sandbox, since it can silently drift or drop columns in prod.
TYPEORM_SYNCHRONIZE=false
# Runs pending migrations automatically on boot (used by docker compose up).
TYPEORM_MIGRATIONS_RUN=true
TYPEORM_LOGGING=true

# Webhook
WEBHOOK_SECRET=change-me-to-a-strong-random-secret

# Connection visibility — see README § Connection visibility
# Transaction duration (ms) above which TransactionRunner logs at warn instead
# of info. Not a timeout — it's just the threshold for "this is worth looking at".
DB_TX_WARN_MS=200
# Kills a transaction that's open but idle (no query running) for this long
# (ms). statement_timeout only cuts a slow query — this catches a connection
# left open and stalled, which never shows up as slowness anywhere else.
DB_IDLE_IN_TX_TIMEOUT_MS=15000
# How often (ms) PoolMetricsService logs pool total/idle/waiting counts.
DB_POOL_METRICS_INTERVAL_MS=30000
