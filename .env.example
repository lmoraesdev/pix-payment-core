# Application
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=pix_payment

# TypeORM
# Schema is managed by migrations (src/database/migrations) — never true outside
# of a throwaway sandbox, since it can silently drift or drop columns in prod.
TYPEORM_SYNCHRONIZE=false
# Runs pending migrations automatically on boot (used by docker compose up).
TYPEORM_MIGRATIONS_RUN=true
TYPEORM_LOGGING=true

# Webhook
WEBHOOK_SECRET=change-me-to-a-strong-random-secret
